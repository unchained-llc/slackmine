# Japanese wording example. Copy to config/slackmine.messages.yml to use it.
# Place this file under the Redmine application's config directory or this
# plugin's config directory. The Redmine application directory takes priority.
# The copied file is ignored by Git. Project-specific wording may be placed under
# projects.<identifier>.messages in the same file.
---
messages:
  app_home:
    title: マイチケット
    all: すべての一覧
    my: 自分の担当
    reported: 報告したチケット
    updated: 更新したチケット
    this_week: 今週が期限
    refresh: 更新
    detail: 詳細を開く
    open: "%{product_name}で開く"
    empty: 未完了のチケットはありません
    unmapped: Slackアカウントが有効な%{product_name}ユーザーに紐づいていません
    limit: 各セクション最大10件の未完了チケットを表示します。最新情報を取得するには、詳細を開くか更新してください
  commands:
    project: プロジェクト
    continue: 次へ
    message_project: プロジェクトを選択してください（最大100件）次のフォームに、選択したメッセージと投稿元リンクが入ります
    source_message: 元のSlackメッセージ
    message_expired: フォームの有効期限が切れました。メッセージのショートカットから開き直してください
    message_retry: 投稿元リンクを取得できませんでした。もう一度お試しください
    processing: この操作は現在処理中です。再実行する前にチケットを確認してください
    background_saved: "%{product_name}にチケットの変更を保存しました"
    background_failed: チケットの変更を保存できませんでした。再試行する前にチケットを確認してください
    full_form: "%{product_name}で完全なフォームを開く"
    help: |-
      *%{command} — チケット操作*
      • `%{command} my` — 自分が担当する未完了チケットを表示（最大10件）
      • `%{command} due` — 自分の期限超過・3日以内が期日のチケットを表示（最大10件）
      • `%{command} reminders` — 設定されたリマインダー期間に基づいて、自分の期限リマインダーを表示。日数の指定はできません
      • `%{command} search キーワード` — チケットの題名を検索（最大10件）
      • `%{command} 123` — チケットを1件表示。Work Objectプレビューが設定されている場合は、自動的にカードで表示
      • `%{command} new [プロジェクト識別子]` — プロジェクトを選択して、チケット作成フォームを開く
      • `%{command} comment 123` — 表示されたボタンからコメント入力フォームを開く。コメント本文はフォームに入力
      • `%{command} status 123 [ステータス名またはID]` — ステータスを直接変更。値を省略すると選択フォームを開く
      • `%{command} assign 123 [ユーザーログイン名、名前、またはID]` — 担当者を直接変更。`me` で自分、`none` で未割当を指定可能。値を省略すると選択フォームを開く
      • `%{command} help` — このヘルプを表示

      結果は自分にのみ表示されます。一覧はリマインダー形式、1件の場合は設定に応じてカードで表示します
    denied: 利用できません。アカウントの紐付け、権限、設定を確認してください
    empty: 該当する結果がありません
    results: チケット（最大10件）
    choose_project: プロジェクトを選択してください（最大20件）。new <プロジェクト識別子> で候補を絞り込めます
    my: 自分の担当チケット
    search: 検索結果
    due: 期限が近いチケット
    reminders: 自分の期限リマインダー
    reminders_empty: 現在のリマインダー設定に該当するチケットはありません
    new: 新しいチケット
    comment: コメントを追加
    status: ステータスを変更
    assign: 担当者を変更
    updated: チケットを更新しました
    unchanged: チケットはすでに指定された値になっています
    no_match: 変更可能な候補を1件に特定できませんでした。IDを指定するか、表示されたボタンから選択してください
    save: 保存
    cancel: キャンセル
    tracker: トラッカー
    subject: 題名
    description: 説明
  work_objects:
    product_name: Redmine
    display_type: チケット
    edit_issue: チケットを編集
    change_assignee: 担当者変更
    open_issue: "%{product_name} で開く"
    assign_to_me: 自分が担当
    start_work: 作業開始
    complete_work: 作業完了
    log_time: 時間記録
    watch_settings: ウォッチ設定
    watching: ウォッチしました
    not_watching: ウォッチ解除しました
    watch: ウォッチ
    unwatch: ウォッチ解除
    add_comment: コメント追加
    reply: 返信
    reply_hint: 直近の担当者に戻してコメントを追加します。担当者を戻せない場合は、コメントのみ追加します
    comment_placeholder: コメントを入力
    edit_title: "#%{id} を編集"
    save: 保存
    cancel: キャンセル
    edit_failed: "⚠️ #%{id} を更新できませんでした。権限と現在の状態を確認してください"
    operation_failed: ⚠️ 操作を実行できませんでした。権限と現在の状態を確認してください
  notification_coalescing:
    history: '過去の更新・全文: <%{url}|#%{id}>'
  thread_notifications:
    added_header: "%{actor} · %{product_name} #%{id} 新しいコメント"
