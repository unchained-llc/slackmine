    deleted_header: "%{actor} · %{product_name} #%{id} のコメント削除"
  thread_comments:
    saved: "✅ %{product_name} #%{id} にコメントを追加しました"
    restricted: "  コメントを追加できませんでした。ユーザーの対応付け、チケットの権限・状態、テキストの長さを確認してください"
    image_failed: "  返信を保存できませんでした。ファイルサイズ、ファイルへのアクセス権、Bot の files:read スコープを確認してください"
